{
  "id": "weather",
  "version": "0.1.0",
  "kind": "plugin",
  "category": "Utilities",
  "display": "Weather",
  "description": "Get the weather for a named place or the person's current place: temperature, conditions, today's high and low, and the chance of rain. Omit place when the person has not named one.",
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "what's the weather in Seattle",
      "how's the weather in Chicago",
      "what's the weather like in Portland",
      "what's the weather like",
      "weather in Denver",
      "how's the weather in Miami today",
      "is it going to rain in Portland today"
    ],
    "patterns": []
  },
  "args": {
    "type": "object",
    "required": [],
    "properties": {
      "place": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "requires": [],
  "optional": [],
  "platforms": [
    "home",
    "bot"
  ],
  "min_role": "child",
  "consequential": false,
  "offline": "unavailable",
  "config": [
    {
      "key": "weather.places",
      "scope": "person",
      "selector": "location",
      "range": {
        "multiple": true,
        "allow_current": false
      },
      "default": [],
      "label": "Weather places",
      "help": "Places saved for weather.",
      "level": "basic",
      "lives_in": "weather",
      "honoured_by": [
        "home"
      ]
    },
    {
      "key": "weather.default_place",
      "scope": "person",
      "selector": "location",
      "range": {
        "multiple": false,
        "allow_current": true
      },
      "default": "current",
      "label": "Weather default place",
      "help": "The place used by default for weather.",
      "level": "basic",
      "lives_in": "weather",
      "honoured_by": [
        "home"
      ]
    }
  ],
  "data_sources": [
    {
      "id": "open-meteo",
      "destination": "Open-Meteo (open-meteo.com), a free public weather API",
      "when": "each time the family asks for the weather",
      "what": "rounded weather coordinates (two decimals for teens and adults; one decimal for children); a spoken place name is sent only when the person names one",
      "who": "Open-Meteo",
      "opt_in": true,
      "retention": "unknown, see Open-Meteo's own policy"
    }
  ],
  "permissions": [
    "net:geocoding-api.open-meteo.com",
    "net:api.open-meteo.com"
  ],
  "notifications": [],
  "cache": {
    "key_template": "weather:{latitude}:{longitude}",
    "ttl_s": 1800,
    "stale_ok_s": 3600,
    "max_bytes": 4096
  },
  "warm": {
    "schedule": "every:1h",
    "keys": [
      {
        "latitude": 47.61,
        "longitude": -122.33,
        "place": "Seattle"
      }
    ]
  },
  "backup": "exclude",
  "background": false,
  "contributes": {
    "widgets": [
      {
        "id": "current",
        "title": "Weather",
        "size": "card",
        "refresh_s": 1800,
        "inputs": {
          "place": "Seattle"
        }
      }
    ]
  },
  "min_app": "0.1.0",
  "tier": 0,
  "quality_scale": "bronze",
  "smoke": {
    "kind": "recipe_fixture",
    "fixture": "tests/smoke.json"
  },
  "incognito": "unaffected",
  "offer": {
    "mode": "base",
    "priority": 8
  },
  "recipe": null
}
